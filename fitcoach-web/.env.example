# Copy this file to .env.local and fill in the values (never commit .env.local).

# Supabase: Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_KEY=your-publishable-key
SUPABASE_SECRET_KEY=your-secret-key

# OpenAI: platform.openai.com > API keys
OPENAI_API_KEY=sk-your-key
OPENAI_MODEL=gpt-4o-mini

# Any long random string. Vercel Cron sends it so only Vercel can trigger the nightly jobs.
CRON_SECRET=make-up-a-long-random-string

# Optional: links to your other apps on the Progress screen
NEXT_PUBLIC_BODYCOACH_URL=https://your-bodycoach.vercel.app
NEXT_PUBLIC_MACROCOACH_URL=https://your-macrocoach.vercel.app
